{
  "name": "@aies/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --packages=external --alias:@aies/engine=../../packages/engine/src/index.ts --alias:@aies/reports=../../packages/reports/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aies/engine": "*",
    "@aies/reports": "*",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^11.0.0",
    "bcryptjs": "^3.0.0",
    "fastify": "^5.12.5",
    "jose": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.0.0"
  },
  "devDependencies": { "@types/pg": "^8.11.0", "@types/node": "^22.0.0", "esbuild": "^0.28.2", "tsx": "^4.23.15", "vitest": "^5.0.3", "typescript": "~5.9.0" }
}
